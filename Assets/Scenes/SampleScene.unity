  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u043D\u0430 \u043F\u043E\u0447\u0438\u043D\u043A\u0443
    \u0432\u044B\u0434\u0430\u044E\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435
    \u043D\u043F\u0441, \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0434\u043D\u0435\u0439 \u043E\u043D\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
    \u0435\u0433\u043E \u0437\u0430 \u0431\u0430\u0431\u043A\u0438 (\u043C\u043E\u0433\u0443\u0442
    \u0434\u0430\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u0435\u043D\u0435\u0433
    \u0435\u0441\u043B\u0438 \u043F\u043E\u0447\u0438\u043D\u043A\u0430 \u0445\u0443\u0451\u0432\u0430\u044F)\n\n\u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u0442\u0438\u0435
    \u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u0430
    \u043F\u043E\u0447\u0438\u043D\u043A\u0438\n\n\u043A\u043E\u0448\u0435\u043B\u0435\u043A
    \u043D\u0435\u043F\u0438\u0441\u044F\u043C (\u0435\u0441\u043B\u0438 \u0437\u0430\u043B\u0430\u043C\u044B\u0432\u0430\u0442\u044C
    \u0446\u0435\u043D\u0443 \u0442\u043E \u043E\u043D\u0438 \u0443\u0439\u0434\u0443\u0442)\n\n\u043F\u0440\u0438
    \u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043D\u0430 \u043E\u0442\u0432\u0435\u0442,
    \u043E\u043D \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u0442\u044C\u0441\u044F\n\n\u0432
    \u0434\u0438\u0430\u043B\u043E\u0433\u043E\u0432\u043E\u043C \u043E\u043A\u043D\u0435
    \u0432\u0440\u0443\u0431\u0430\u0442\u044C \u0443\u043B\u044C\u0442\u0440\u043E\u0444\u0438\u043E\u043B\u0435\u0442\n\n\u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
    \u043F\u043E\u0434\u044A\u0435\u0436\u0434\u0430 \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
    \u0442\u0430\u043C \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435\u0442\n\u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u043D\u043F\u0441\n\u0446\u0438\u043A\u043B
    \u0434\u043D\u044F (\u043A\u043E\u043D\u0444\u0438\u0433 \u0433\u043E\u0441\u0442\u0435\u0439
    \u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0437\u0430\u043F\u0430\u0441\u043E\u0432)\n\u0437\u0432\u0443\u043A\u0438
    \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E\n\n\u0433\u043E\u043B\u0443\u0431\u044C
    (\u0447\u0442\u0435\u043D\u0438\u0435 + \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435)\n\u043C\u043E\u043B\u0438\u0442\u0432\u0430\n\u043C\u043E\u043D\u0441\u0442\u0440\u044B"
